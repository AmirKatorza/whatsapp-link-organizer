# Copy this file to .env and fill in the values you need.
# Lines starting with # are comments and are ignored.

# ── Anthropic (Claude API) ─────────────────────────────────────────────────────
# Required for LLM-based categorization fallback on uncertain links.
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model to use for categorization fallback.
# Haiku is fast and cheap; Sonnet is more accurate for ambiguous links.
# Options: claude-haiku-4-5-20251001 | claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Categorization ─────────────────────────────────────────────────────────────
# Confidence threshold below which the LLM fallback is triggered (0.0–1.0).
# Lower = more LLM calls. Raise to 0.8+ for rules-only on most links.
CATEGORIZATION_RULE_CONFIDENCE_THRESHOLD=0.62

# Set to 0 to disable LLM fallback entirely (rules-only, no API calls).
CATEGORIZATION_ENABLE_LLM_FALLBACK=1

# ── Meta API (optional, not needed for backlog clearance) ──────────────────────
# Enables richer title/description for Facebook and Instagram links.
# Obtain via: https://developers.facebook.com → create app → oEmbed Read permission.
META_ACCESS_TOKEN=

# Set to 1 to enable Playwright browser fallback when Meta API fails.
# Requires: playwright install chromium
META_ENABLE_PLAYWRIGHT=0
